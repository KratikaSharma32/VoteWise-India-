{
  "name": "votewise-india",
  "version": "1.0.0",
  "description": "AI-Powered Civic Intelligence Platform for Indian Democracy",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
